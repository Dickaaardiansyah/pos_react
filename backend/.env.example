PORT=3001
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_refactor

# WAJIB DIGANTI dengan secret JWT milik Anda sendiri
JWT_SECRET=ganti_dengan_jwt_secret_anda

# WAJIB DIGANTI sesuai kebutuhan, contoh: 1d, 7d, 24h
JWT_EXPIRES_IN=ganti_dengan_masa_berlaku_jwt

# Web Push (notifikasi stok habis/menipis/reorder point ke browser).
# Generate dengan: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=ganti_dengan_public_key_anda
VAPID_PRIVATE_KEY=ganti_dengan_private_key_anda
VAPID_SUBJECT=mailto:admin@example.com

# Info toko (tampil di struk) — nilai default, bisa diubah lewat menu Pengaturan
STORE_NAME=Toko Saya
STORE_ADDRESS=Jl. Contoh No. 123, Kota
STORE_PHONE=08123456789
STORE_EMAIL=toko@email.com