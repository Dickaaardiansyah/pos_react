{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "QasirQu — Sumber Rahayu",
  "short_name": "QasirQu",
  "description": "Sistem kasir (POS) untuk Toko Sumber Rahayu — penjualan, stok, dan laporan keuangan dalam satu aplikasi.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "lang": "id",
  "dir": "ltr",
  "background_color": "#f5f7fb",
  "theme_color": "#2563eb",
  "categories": ["business", "finance", "productivity"],

  "icons": [
    {
      "src": "/icons/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Kasir",
      "short_name": "Kasir",
      "description": "Buka halaman kasir untuk transaksi baru",
      "url": "/kasir",
      "icons": [{ "src": "/icons/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Riwayat Transaksi",
      "short_name": "Transaksi",
      "description": "Lihat riwayat transaksi",
      "url": "/transaksi",
      "icons": [{ "src": "/icons/logo.png", "sizes": "192x192" }]
    }
  ]
}
